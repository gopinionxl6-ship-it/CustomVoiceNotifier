<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Checking..."
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSelectVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Add Custom Person's Voice (.mp3/.wav)" />

        <Button
            android:id="@+id/btnTestVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Custom Voice Now"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnGrantNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Enable Notification Access" />

        <Button
            android:id="@+id/btnGrantUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Enable Usage Access (Active App Check)"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editTargetPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="App Package (blank = all apps, or com.whatsapp)" />

        <EditText
            android:id="@+id/editRequireText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Require keyword (optional)"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/chkActiveOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only alert when this app is actively running on screen"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/chkScreenOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speak when Screen is ON"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkScreenOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speak when Screen is OFF"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkSuspend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause / Suspend All Alerts" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save All Settings" />

    </LinearLayout>
</ScrollView>
